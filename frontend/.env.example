# Desarrollo local: Vite en :5173 habla con Django en :8000.
# La imagen de producción no usa este archivo. El build deja la variable
# vacía y el navegador llama a /api en el mismo origen; Nginx hace de proxy.
VITE_API_BASE_URL=http://localhost:8000
# Opcional: URL pública que se incluye en el QR de vinculación de dispositivos.
# Si se omite se usa la dirección desde la que se abre la web.
# VITE_URL_PUBLICA=http://3.149.4.52
