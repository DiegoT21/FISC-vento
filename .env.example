# Variables que docker-compose inyecta al servicio `db` (y que backend/.env
# también debe repetir para que Django se conecte con las mismas credenciales).
# Los secretos propios de cada servicio van en backend/.env y frontend/.env
# (ver sus respectivos .env.example), no aquí.
# Sirve igual para docker-compose.yml (desarrollo) y docker-compose.prod.yml.
POSTGRES_DB=fiscvento
POSTGRES_USER=fiscvento
POSTGRES_PASSWORD=fiscvento

# Opcional en los servidores. Por defecto Gunicorn usa 2 workers.
# GUNICORN_WORKERS=2
