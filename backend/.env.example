# Desarrollo local. En los servidores, docker-compose.prod.yml fuerza
# config.settings.prod y DJANGO_DEBUG=0. La clave change-me no sirve ahí:
# el despliegue la reemplaza (scripts/preparar_env_produccion.sh) si sigue
# siendo débil. No pegues una clave real en este archivo.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Solo servidores, cuando haya certificado (ver docs/arquitectura.md):
# DJANGO_SECURE_SSL=1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.fisc.example
# DJANGO_ALLOWED_HOSTS=app.fisc.example
# DJANGO_CORS_ALLOWED_ORIGINS=https://app.fisc.example

POSTGRES_DB=fiscvento
POSTGRES_USER=fiscvento
POSTGRES_PASSWORD=fiscvento
POSTGRES_HOST=db
POSTGRES_PORT=5432
